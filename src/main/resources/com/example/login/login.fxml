<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<AnchorPane fx:id="rootPane" prefHeight="385.0" prefWidth="472.0" styleClass="root-pane" stylesheets="@css/login.css" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.login.controllers.LoginController">

    <VBox alignment="CENTER" spacing="20" AnchorPane.bottomAnchor="0" AnchorPane.leftAnchor="0" AnchorPane.rightAnchor="0" AnchorPane.topAnchor="0">


        <HBox alignment="CENTER" spacing="10" styleClass="header-box">
            <Label styleClass="header-label" text="Bienvenido" />
            <Label style="-fx-font-size: 40px;" text="👋" />
        </HBox>


        <VBox alignment="CENTER_LEFT" maxWidth="300" spacing="10">
            <Label text="Correo electrónico:" />
            <TextField fx:id="txtCorreo" promptText="example@gmail.com" styleClass="text-field" />

            <Label text="Contraseña:" />
            <PasswordField fx:id="txtContraseña" promptText="12345" styleClass="password-field" />
        </VBox>


        <Button fx:id="btnIngresar" maxWidth="200" onAction="#onIngresar" styleClass="login-button" text="Iniciar Sesión" />

    </VBox>
</AnchorPane>
