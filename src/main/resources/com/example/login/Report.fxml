<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<AnchorPane prefHeight="600" prefWidth="800" style="-fx-background-color: linear-gradient(to bottom right, #1a1a1a, #3b0066);" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.login.controllers.ReportController">

    <VBox alignment="TOP_CENTER" spacing="20" AnchorPane.leftAnchor="50" AnchorPane.rightAnchor="50" AnchorPane.topAnchor="30">

        <!-- Título -->
        <Label style="-fx-font-size: 24px; -fx-text-fill: white; -fx-font-weight: bold;" text="Reporte de Cliente" />

        <!-- Selección de cliente -->
        <HBox alignment="CENTER_LEFT" spacing="10">
            <Label style="-fx-text-fill: white;" text="Cliente:" />
            <ComboBox fx:id="cbClients" prefWidth="300" promptText="Seleccionar cliente" />
            <Label text="Desde:" style="-fx-text-fill: white;" />
            <DatePicker fx:id="dpInicial" />
            <Label text="Hasta:" style="-fx-text-fill: white;" />
            <DatePicker fx:id="dpFinal" />
            <Button onAction="#generarReporteCliente" text="Generar Reporte" />
        </HBox>

        <!-- Tabla de movimientos -->
        <TableView fx:id="tblReporte" prefHeight="300" style="-fx-background-color: white;">
            <columns>
                <TableColumn fx:id="colDate" prefWidth="200" text="Fecha" />
                <TableColumn fx:id="colTipo" prefWidth="200" text="Tipo" />
            <TableColumn fx:id="colMonto" prefWidth="200" text="Monto" />
            </columns>
        </TableView>

        <!-- Resumen -->
        <VBox alignment="CENTER_LEFT" spacing="10">
            <Label fx:id="lblResumenTotal" style="-fx-text-fill: white;" text="Total movido: $" />
            <Label fx:id="lblResumenAlertas" style="-fx-text-fill: white;" text="Alertas detectadas: " />
        </VBox>

    </VBox>
</AnchorPane>
